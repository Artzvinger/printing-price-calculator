# Скопируй этот файл в .env.local (для локальной разработки)
# или задай переменные в настройках Vercel (для продакшена).

# URL развёрнутого веб-приложения Google Apps Script.
# Используется в api/proxy.js и src/setupProxy.js.
GAS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbw1XtwFPUTyuXk5Dlc0QVE6UCCN2UO-Y_Wz_q5ElvYSZcUJwEJq4MwDflwHWNfFkz9s/exec

# ID Google-таблицы задаётся НЕ здесь, а в самом скрипте:
# Расширения → Apps Script → Файл → Настройки проекта → Свойства скрипта
#   ключ: SPREADSHEET_ID
#   значение: id вашей таблицы
